# ─── Dependencias / entornos ────────────────────────────────────
node_modules/
.venv
.venv.*
.env

# ─── Sistema / IDE ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/

# ─── Python / build ─────────────────────────────────────────────
__pycache__/
*.pyc
dist/
build/
.gradio

# ─── Logs ───────────────────────────────────────────────────────
*.log
logs/
inference_logs/

# ─── Modelos y pesos entrenados ─────────────────────────────────
*.pt
*.pth

# ─── Datos: datasets, grabaciones y evaluaciones son locales ────
data/

# ─── Salidas de entrenamiento / evaluación (generadas) ──────────
runs/                       # carpetas de runs de RL/IL (checkpoints, métricas)
agent_metrics/
agents.json
agents_*.json
# Memorias de agentes en runtime (se conserva el ejemplo, si lo hubiera)
src/agents/memories/
!src/agents/memories/*example*

# ─── Servidor Minecraft (Paper) ─────────────────────────────────
server/

# ─── Memoria (TFG): fuentes LaTeX y PDF sí; vídeos y gifs pesados no ─
memoria/videos/
memoria/**/gifs/

# ─── Artefactos LaTeX ───────────────────────────────────────────
*.aux
*.out
*.acn
*.glo
*.ist
*.lof
*.lot
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
